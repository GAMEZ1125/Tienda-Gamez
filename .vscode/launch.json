{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "deviceId": "${input:deviceId}"
    },
    {
      "name": "Flutter: Release APK",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "deviceId": "${input:deviceId}",
      "preLaunchTask": "flutter: build apk release"
    },
    {
      "name": "Flutter: Profile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "deviceId": "${input:deviceId}"
    }
  ],
  "inputs": [
    {
      "id": "deviceId",
      "type": "promptString",
      "description": "Device ID for Flutter",
      "default": "8PAAVWL78HTGUCOZ"
    }
  ]
}
